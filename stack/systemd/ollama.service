[Unit]
Description=Ollama (user-level, no sudo) - local LLM for Hermes + Hindsight
After=network-online.target

[Service]
ExecStart=%h/.local/share/ollama-bin/bin/ollama serve
# Loopback only. Docker Desktop containers reach it via host.docker.internal (proxied to host loopback).
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_CONTEXT_LENGTH=65536
Environment=OLLAMA_FLASH_ATTENTION=1
Environment=OLLAMA_KV_CACHE_TYPE=q8_0
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_KEEP_ALIVE=30m
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
